# KPI lab — copy to .env and fill in your values:
#   cp .env.example .env
# `.env` is gitignored. Every knob can also be exported as a real environment
# variable instead of using a .env file.

# Path to a Hermes kanban.db (sqlite) to snapshot. Required for `make data`.
KANBAN_DB=/path/to/kanban.db

# Gitea API base URL to pull commit history from. Required for `make data`
# (public repos need no credential).
GITEA_API=https://your-gitea.example.com/api/v1

# Optional. If set, private repos are included in the commit-history pull.
GITEA_TOKEN="

# Home Assistant recorder Postgres DSN, read from the environment only (sourced from BWS
# by whoever runs the fetch — never committed, never written to a file). Required for
# `make data-ha` / `make data`.
HA_POSTGRES_URL=postgresql://user:pass@host:5432/hass

# Optional. Set to any non-empty value (e.g. `1`) to also snapshot the 30-day 5-minute
# table (statistics_short_term) as `ha_short_term_5min.parquet`.
HA_SHORT_TERM=
